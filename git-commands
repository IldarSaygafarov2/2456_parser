git -v - проверка версии гита на компе
ssh-keygen - генерация ssh ключа на компе
.gitignore - файл, в котором описаны папки и файлы не отправляемые в репозиторий

git init - инициализация пустого репозитория внутри проекта
git config user.name "username" - добавление имени пользователя отправителя
git config user.email "email" - добавление почты пользователя отправителя

git config --global user.name "username" - глобальное добавление имени пользователя отправителя
git config --global user.email "email" - глобальное добавление имени пользователя отправителя